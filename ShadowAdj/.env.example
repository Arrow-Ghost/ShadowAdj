# Copy to .env and fill in. Never commit .env (it is gitignored; this file is not).
# Get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

PORT=8787
CORS_ORIGIN=http://localhost:4321

# auto  = server-side Gemini transcription when a key is set, else browser
# browser = always use the Web Speech API
TRANSCRIPTION=auto

# Analysed audio is held in memory only and discarded when the session ends.
# Set to 1 to also write a session transcript JSON to ./data for later review.
PERSIST_TRANSCRIPTS=0
