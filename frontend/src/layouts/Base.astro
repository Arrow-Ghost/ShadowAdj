---
import '@/styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'ShadowADJ — Speech reflection, AI judging & integrity review',
  description = 'A consent-first console that shows descriptive metrics about how someone is speaking, scores a session against a rubric with evidence and human override, and surfaces integrity signals as evidence for a reviewer — never a verdict.',
} = Astro.props;

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Overview' },
  { href: '/console', label: 'Console' },
  { href: '/judge', label: 'Judge HUD' },
  { href: '/review', label: 'Case Review' },
  { href: '/coach', label: 'Coach' },
  { href: '/admin', label: 'Admin' },
  { href: '/history', label: 'History' },
  { href: '/about', label: 'Architecture' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ViewTransitions />
  </head>
  <body class="min-h-screen">
    <div id="scroll-progress" aria-hidden="true"></div>

    {/* Atmosphere — a dark chamber with soft cool light */}
    <div class="atmos" aria-hidden="true">
      <div class="atmos-grid"></div>
      <div class="atmos-grain"></div>
    </div>

    {/* Custom cursor (CSS-gated to desktop, non-reduced-motion) */}
    <div id="cursor-dot" aria-hidden="true"></div>
    <div id="cursor-ring" aria-hidden="true"></div>

    {/* ── Floating glass navigation ─────────────────────────────── */}
    <header class="sticky top-0 z-50 px-3 pt-3 sm:px-5 sm:pt-4">
      <div
        id="site-nav"
        class="mx-auto flex max-w-6xl items-center justify-between gap-3 rounded-2xl border border-white/[0.08]
          bg-ink-900/55 px-3 py-2 backdrop-blur-xl transition-all duration-500 ease-glass
          [&.is-scrolled]:bg-ink-900/80 [&.is-scrolled]:border-white/[0.12] [&.is-scrolled]:py-1.5 [&.is-scrolled]:shadow-glass"
      >
        <a href="/" class="group flex items-center gap-2.5" data-cursor="hover">
          <span class="relative flex h-8 w-8 items-center justify-center rounded-xl border border-white/12 bg-white/[0.04]">
            <span class="h-1.5 w-1.5 rounded-full bg-teal shadow-[0_0_10px_rgba(111,180,172,0.8)]"></span>
            <span class="absolute inset-0 rounded-xl border border-teal/20 animate-breathe"></span>
          </span>
          <span class="font-display text-[17px] font-medium tracking-editorial text-mist-50">
            Shadow<span class="text-mist-400">ADJ</span>
          </span>
        </a>

        <nav class="hidden lg:flex items-center gap-0.5 rounded-full border border-white/[0.06] bg-white/[0.02] p-1">
          {
            nav.map((n) => {
              const active = isActive(n.href);
              return (
                <a
                  href={n.href}
                  aria-current={active ? 'page' : undefined}
                  data-cursor="hover"
                  class={`relative rounded-full px-3 py-1 text-[12px] font-medium tracking-tight transition-colors duration-300 ${
                    active ? 'text-mist-50' : 'text-mist-400 hover:text-mist-100'
                  }`}
                >
                  {active && (
                    <span class="absolute inset-0 rounded-full border border-white/12 bg-white/[0.06]" aria-hidden="true"></span>
                  )}
                  <span class="relative">{n.label}</span>
                </a>
              );
            })
          }
        </nav>

        <div class="flex items-center gap-2">
          <a href="/console" data-magnetic="0.25" data-cursor="hover" class="btn btn-primary hidden sm:inline-flex !py-1.5 !px-4 !text-[12px]">
            Open Console
          </a>
          <button
            id="sa-nav-toggle"
            type="button"
            aria-label="Toggle navigation"
            aria-expanded="false"
            aria-controls="sa-mobile-nav"
            class="lg:hidden inline-flex h-9 w-9 items-center justify-center rounded-xl border border-white/12 bg-white/[0.04] text-mist-200 transition active:scale-90"
          >
            <svg class="sa-ico-open h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 8h16M4 16h16" /></svg>
            <svg class="sa-ico-close hidden h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </div>
      </div>

      {/* Mobile drawer */}
      <nav id="sa-mobile-nav" hidden class="lg:hidden mx-auto mt-2 max-w-6xl rounded-2xl border border-white/10 bg-ink-900/90 p-2 backdrop-blur-xl shadow-glass">
        <div class="grid gap-0.5">
          {
            nav.map((n) => {
              const active = isActive(n.href);
              return (
                <a
                  href={n.href}
                  aria-current={active ? 'page' : undefined}
                  class={`rounded-xl px-3.5 py-2.5 text-sm font-medium transition ${
                    active ? 'bg-white/[0.06] text-mist-50 border border-white/10' : 'text-mist-300 hover:bg-white/[0.04] hover:text-mist-100'
                  }`}
                >
                  {n.label}
                </a>
              );
            })
          }
          <a href="/console" class="btn btn-primary mt-1 text-sm">Open Console</a>
        </div>
      </nav>
    </header>

    <main class="relative z-10">
      <slot />
    </main>

    {/* ── Footer ───────────────────────────────────────────────── */}
    <footer class="relative z-10 mt-24 border-t border-white/[0.06]">
      <div class="mx-auto max-w-6xl px-5 py-12">
        <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
          <div class="max-w-sm">
            <div class="flex items-center gap-2.5">
              <span class="flex h-7 w-7 items-center justify-center rounded-lg border border-white/12 bg-white/[0.04]">
                <span class="h-1.5 w-1.5 rounded-full bg-teal"></span>
              </span>
              <span class="font-display text-[15px] tracking-editorial text-mist-100">ShadowADJ</span>
            </div>
            <p class="mt-3 text-[13px] leading-relaxed text-mist-400">
              The system reflects. The speaker competes. The human decides. Similarity is evidence for a
              reviewer, not a verdict.
            </p>
          </div>
          <nav class="grid grid-cols-2 gap-x-12 gap-y-2 text-[13px] sm:grid-cols-3">
            {nav.map((n) => <a href={n.href} class="text-mist-400 transition hover:text-mist-100">{n.label}</a>)}
          </nav>
        </div>
        <div class="mt-10 flex flex-col gap-2 border-t border-white/[0.06] pt-6 text-[11px] text-mist-500 sm:flex-row sm:items-center sm:justify-between">
          <span>ShadowADJ — consent-first speech practice &amp; reflection console.</span>
          <span class="font-mono">Press <kbd>?</kbd> for keyboard shortcuts</span>
        </div>
      </div>
    </footer>

    {/* Interaction layer */}
    <script>
      import '@/lib/ui/reveal';
      import '@/lib/ui/hotkeys';
      import '@/lib/ui/site';
    </script>

    {/* Mobile nav toggle — re-wired after each view transition */}
    <script>
      function wireNav() {
        const btn = document.getElementById('sa-nav-toggle');
        const panel = document.getElementById('sa-mobile-nav');
        if (!btn || !panel || (btn as any)._wired) return;
        (btn as any)._wired = true;
        const openIco = btn.querySelector('.sa-ico-open');
        const closeIco = btn.querySelector('.sa-ico-close');
        const set = (show: boolean) => {
          panel.hidden = !show;
          btn.setAttribute('aria-expanded', String(show));
          openIco?.classList.toggle('hidden', show);
          closeIco?.classList.toggle('hidden', !show);
        };
        btn.addEventListener('click', () => set(panel.hidden));
        panel.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).tagName === 'A') set(false);
        });
      }
      wireNav();
      document.addEventListener('astro:page-load', wireNav);
    </script>
  </body>
</html>
