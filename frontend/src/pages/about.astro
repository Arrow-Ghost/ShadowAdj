---
import Base from '@/layouts/Base.astro';

const modules = [
  ['speech-core', 'Audio ingest → streaming voice-activity detection → windowed analyzer. Emits a descriptive snapshot; a transcription pump runs server or browser STT with automatic fallback.'],
  ['ai', 'One gateway is the single model call site. It builds compact prompts from structured state, walks a model fallback list, validates JSON with a repair retry, caches by content hash, and logs cost.'],
  ['judge-engine', 'Rubric-driven, per-criterion scoring with quoted evidence, strengths, weaknesses and reasoning. A deterministic guard can only lower the model’s confidence. Human override keeps both scores.'],
  ['integrity', 'Source matching, cross-participant similarity, per-speaker style deviation, preparedness and session-integrity checks, aggregated to a risk level under the event policy.'],
  ['coach', 'Consumes the judge’s exact weaknesses — verbatim — and turns them into a plan, adaptive drills, an AI opponent and a before/after progress series. Emits no integrity signal.'],
  ['competition', 'Multi-judge consensus and spread, deterministic tie-break, public and admin leaderboards, post-event analytics, an append-only event audit, and an in-process job queue.'],
  ['storage', 'A StorageProvider interface over SQLite (node:sqlite) — one file. Append-only audit trail; SHA-256 session-artifact hashes for tamper-evidence.'],
  ['domain', 'Event, Round, Participant, Session and Rubric entities with validators. Rubric presets for debate, interview, speech and hackathon pitch.'],
];

const rules = [
  ['Consent-first', 'createSession returns 403 until both parties acknowledge in the UI. Enforced server-side, asserted in tests.'],
  ['Descriptive, not evaluative', 'The live snapshot never contains a "verdict" or "authorship" field.'],
  ['No lonely signal', 'No single integrity origin can reach HIGH risk on its own — a contribution cap sits below the threshold.'],
  ['AI proposes, human disposes', 'Every judge criterion is overridable; the AI score is never discarded.'],
  ['Confidence only falls', 'A deterministic guard sits on top of the model’s self-reported confidence and can only lower it, with a stated reason.'],
  ['Performance ≠ integrity', 'A judge evaluation carries no integrity signal; an integrity case carries no score.'],
];
---

<Base title="ShadowADJ — architecture" description="How ShadowADJ is built: a thin transport, a single model call site, and separate engines for reflection, judging and integrity — with the guardrails enforced in code.">
  <script>
    import '@/lib/ui/scroll-fx';
  </script>
  <section class="mx-auto max-w-4xl px-5 py-24">
    <p class="eyebrow reveal">Architecture</p>
    <h1 class="reveal mt-5 font-display text-[clamp(2.4rem,6vw,4rem)] font-light leading-[1.02] tracking-tightest text-mist-50">
      A thin transport.
      <br />
      Everything real in the engines.
    </h1>
    <p class="reveal mt-6 max-w-2xl text-[15px] leading-relaxed text-mist-300">
      The HTTP + WebSocket entrypoint does routing and framing and nothing else. Speech work lives in
      <span class="font-mono text-mist-100">speech-core</span>, every model call in one gateway, durability
      behind a storage interface, and domain logic in four independent engines.
    </p>

    <div class="stagger reveal mt-16 grid gap-3 sm:grid-cols-2">
      {modules.map(([k, d]) => (
        <div class="glass p-5">
          <span class="font-mono text-[12px] tracking-[0.12em] text-teal/80">{k}</span>
          <p class="mt-2.5 text-[13px] leading-relaxed text-mist-400">{d}</p>
        </div>
      ))}
    </div>

    <h2 data-wipe class="mt-24 font-display text-[clamp(1.8rem,4vw,2.8rem)] font-light leading-[1.1] text-mist-50">
      Design principles, enforced in code
    </h2>
    <ul class="reveal mt-10 divide-y divide-white/[0.06] rounded-2xl border border-white/[0.07] bg-white/[0.015]">
      {rules.map(([k, d]) => (
        <li class="flex flex-col gap-1.5 p-5 sm:flex-row sm:gap-6">
          <span class="w-52 shrink-0 text-[13px] font-medium text-mist-100">{k}</span>
          <span class="text-[13px] leading-relaxed text-mist-400">{d}</span>
        </li>
      ))}
    </ul>

    <h2 data-wipe class="mt-24 font-display text-[clamp(1.8rem,4vw,2.8rem)] font-light leading-[1.1] text-mist-50">
      Stack
    </h2>
    <div class="reveal mt-10 grid gap-3 sm:grid-cols-2">
      <div class="glass-hair p-5">
        <span class="metric-label">Backend</span>
        <p class="mt-2 text-[13px] leading-relaxed text-mist-400">
          TypeScript on Node, run directly. Express + <span class="font-mono">ws</span> on one server.
          <span class="font-mono">node:sqlite</span>. Groq or Gemini behind the gateway. scrypt + HMAC auth.
        </p>
      </div>
      <div class="glass-hair p-5">
        <span class="metric-label">Frontend</span>
        <p class="mt-2 text-[13px] leading-relaxed text-mist-400">
          Astro static pages, React islands, Zustand for the live console, Tailwind, Three.js for the hero,
          GSAP + Lenis for the scroll choreography, Web Audio for capture.
        </p>
      </div>
    </div>

    <div class="reveal mt-20 flex flex-wrap gap-3">
      <a href="/console" data-cursor="hover" class="btn btn-primary">Open the console</a>
      <a href="/" data-cursor="hover" class="btn btn-ghost">Back to overview</a>
    </div>
  </section>
</Base>
